{
  /* Kiểm kiểu KHÔNG có bước build: `tsc --noEmit` chỉ đọc JSDoc rồi báo lỗi,
     không sinh ra tệp nào. Deploy vẫn nguyên xi — đúng ràng buộc zero-build.

     Chỉ soi mã ứng dụng (public/src + functions). Bộ kiểm và tools/ nằm ngoài
     vì chúng import .js của node_modules (chai, acorn-globals) — kéo cả đống mã
     không phải của mình vào chương trình, 300 lỗi không liên quan gì tới dự án. */
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "types": []
  },
  "include": ["public/src/**/*.js", "public/src/**/*.d.ts", "functions/**/*.js"],
  "exclude": ["node_modules", "public/vendor"]
}
